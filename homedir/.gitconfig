[user]
  name = Wei Zhu
  email = zhuwei@umich.edu
[github]
  user = marwei
[color]
  ui = auto
[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green
[color "diff"]
  meta = yellow bold
  frag = magenta bold
  old = red bold
  new = green bold
[color "status"]
  added = yellow
  changed = green
  untracked = cyan

[advice]
  statusHints = false

[core]
  excludesfile = ~/.gitignore
  quotepath = false
  autocrlf = input
  safecrlf = warn
  editor = vim

[alias]
  co = checkout
  cob = checkout -b
  d = diff --color-words
  dc = diff --staged
  dh = diff HEAD
  cam = commit -a -m
  c = commit
  s = status -s -u
  st = status
  br = branch -a
  up = pull --rebase --autostash
  upm = !git fetch upstream && git merge upstream/main
  ph = push
  pl = pull
  sync = !git pull && git push
  l = log --graph --all --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
  lod = log --oneline --decorate
  lol = log --pretty=oneline --graph --abbrev-commit --all
  ri = rebase --interactive --autosquash
  fixup = "!sh -c 'git commit -m \"fixup! $(git log -1 --format='\\''%s'\\'' $@)\"' -"
  squash = "!sh -c 'git commit -m \"squash! $(git log -1 --format='\\''%s'\\'' $@)\"' -"
  sno = show --name-only
  who = shortlog -s --
  rv = remote -v
  ignorechanges = update-index --assume-unchanged
  noticechanges = update-index --no-assume-unchanged

[apply]
  whitespace = nowarn

[rerere]
  enabled = 1

[difftool]
  prompt = false

[init]
  templatedir = ~/.dotfiles/.git_template

[merge]
  tool = vscode
[mergetool "vscode"]
  cmd = code --wait $MERGED
[diff]
  tool = vscode
[difftool "vscode"]
  cmd = code --wait --diff $LOCAL $REMOTE

[credential]
  helper = cache

[push]
  default = matching
  followTags = true

[filter "lfs"]
  clean = git-lfs clean %f
  smudge = git-lfs smudge %f
  required = true

[pull]
  rebase = true
